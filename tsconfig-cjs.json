{
	"extends": "./tsconfig-base.json",
	"compilerOptions": {
		"module": "commonjs",
		"target": "es5",
		"lib": ["dom", "esnext"],
		"outDir": "lib",
		"composite": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true
	},
	"exclude": ["node_modules", "lib", "samples", "test/development"],
	"include": ["./src/**/*.ts", "./test"]
}
